[Unit]
Description=ZERO Streamlit UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/Zero/ZERO-PERSONAL-ASISTANT
Environment="PATH=/root/Zero/ZERO-PERSONAL-ASISTANT/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=/root/Zero/ZERO-PERSONAL-ASISTANT/.env
ExecStart=/bin/bash -lc '. /root/Zero/ZERO-PERSONAL-ASISTANT/.venv/bin/activate && streamlit run Zero.py --server.port 8501 --server.address 0.0.0.0 --server.headless true'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target