[Unit]
Description=ZERO (docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/zero
# Use el usuario que creó el despliegue (opcional). Asegúrate de que este usuario tenga permisos para docker.
User=deploy
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
