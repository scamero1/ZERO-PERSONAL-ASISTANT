FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libffi-dev libsrtp2-dev libssl-dev pkg-config ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install --prefer-binary --no-cache-dir -r requirements.txt && pip install gunicorn
COPY . .
ENV PYTHONUNBUFFERED=1
CMD ["gunicorn", "-w", "3", "-b", "0.0.0.0:8000", "app:app"]