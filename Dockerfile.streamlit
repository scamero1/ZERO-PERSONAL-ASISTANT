FROM python:3.12-slim
WORKDIR /app
# Paquetes de sistema para deps nativas (aiortc/pylibsrtp/cryptography)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libffi-dev libsrtp2 libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install --prefer-binary --no-cache-dir -r requirements.txt
COPY . .
ENV PYTHONUNBUFFERED=1
CMD ["streamlit", "run", "Zero.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.baseUrlPath", "/app", "--server.headless", "true"]